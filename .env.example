# Settings for THIS machine. Copy to .env and edit. .env is never committed.
# Passwords and keys are not here: `npm run configure` generates them once into .state/ (also never committed).

# ---- Addresses --------------------------------------------------------------------------------
# Where visitors open the platform (the Vercel "portal" project). No trailing slash.
PUBLIC_ORIGIN=https://portal.example.com
# The public address of the tunnel that reaches this machine (Tailscale Funnel or a Cloudflare tunnel). No trailing slash.
BACKEND_ORIGIN=https://this-machine.example.ts.net
# Optional: the MOS (Odoo) system, if it runs next to this platform. Leave empty if it does not.
MOS_ORIGIN=
# How the containers reach MOS on this machine (Docker Desktop provides host.docker.internal).
MOS_INTERNAL_URL=http://host.docker.internal:8069
# Only for `npm run roles:backfill` (a one-time step when an application starts being managed from the console): where MOS's people file is
# (tools/mos-people.json in the MOS repository: login and role per person), and who administers MOS (comma-separated addresses).
MOS_PEOPLE_FILE=
MOS_ADMIN_EMAILS=
# Only for `npm run smoke:access`'s MOS half: the file that holds MOS_DB_PASSWORD, and the name of MOS's database container (default mos-odoo-db-1).
MOS_ENV_FILE=
MOS_DB_CONTAINER=
# The web address of each product app (their web parts run on Vercel): used to register them with the identity provider.
APP_WEB_ORIGINS={"retail-os":"https://retail.example.com","jobpilot":"https://jobpilot.example.com","martronics":"https://shop.example.com","library":"https://library.example.com"}

# ---- Ports on this machine (all bound to 127.0.0.1) -------------------------------------------
# The one door from the tunnel to the platform.
ENTRY_PORT=15080
# For tools such as psql and the MinIO console.
POSTGRES_PORT=5440
VALKEY_PORT=6390
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091

# ---- Docker -----------------------------------------------------------------------------------
# The first three numbers of the platform's private network (a /24). The identity, guest and document systems get fixed
# addresses on it (.10, .20 and .30) so each one's internal API can be limited to exactly its callers. Change it only if
# `docker network ls` shows another network already using this range.
PLATFORM_SUBNET=172.29.181
# Changing this creates a second, separate platform (new volumes). Keep it for the real one.
COMPOSE_PROJECT_NAME=saas-hosting
# Container time zone for logs.
TZ=UTC

# ---- Watchdog (npm run pm2:start) ---------------------------------------------------------------
# Seconds between the watchdog's checks (default 20, minimum 5).
WATCHDOG_INTERVAL_SECONDS=20

# ---- Backups ----------------------------------------------------------------------------------
# How many nightly database dumps to keep.
BACKUP_KEEP=7

# ---- The public sandbox login (for `npm run smoke` and the visitor reset) -----------------------
# This account is published on the portfolio on purpose; it is a system administrator of the demos, never a platform administrator.
DEMO_EMAIL=demo.admin@examplecorp.com
DEMO_PASSWORD=

# ---- Vercel (for `npm run deploy:vercel`) ---------------------------------------------------------
# The projects are named <VERCEL_PREFIX>-portal, -sso, -gms, -dms, -retail, -jobpilot, -martronics, -library.
VERCEL_PREFIX=saas
# Your Vercel team's slug, if the projects belong to a team (leave empty for a personal account).
VERCEL_TEAM=
# The addresses of the three systems' web parts on Vercel (the portal forwards /sso, /dms and /gms to them).
FRONTEND_ORIGINS={"sso":"https://sso.example.vercel.app","dms":"https://dms.example.vercel.app","gms":"https://gms.example.vercel.app"}
