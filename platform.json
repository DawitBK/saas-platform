{
  "_note": "The one place that says what the platform is made of: which repositories, which internal ports, which databases. Machine-specific values (addresses, host ports) are in .env, never here. test/topology.test.mjs checks this file against compose.yml.",
  "editions": [
    { "name": "sso-saas", "repo": "https://github.com/DawitBK/sso-saas", "ref": "main" },
    { "name": "dms-saas", "repo": "https://github.com/DawitBK/dms-saas", "ref": "main" },
    { "name": "gms-saas", "repo": "https://github.com/DawitBK/gms-saas", "ref": "main" }
  ],
  "ports": { "sso": 7300, "gateway": 4200, "dms": 7100, "gms": 7200, "postgres": 5432, "valkey": 6379, "minio": 9000 },
  "databases": { "sso": "sso_saas", "dms": "dms_saas", "gms": "gms_saas" },
  "apps": {
    "retail-os": {
      "service": "retail",
      "repo": "https://github.com/DawitBK/retail-os",
      "ref": "main",
      "dir": "apps/retail-os",
      "port": 16101,
      "db": "retail_os",
      "label": "Retail OS",
      "tile": "Retail OS: till, stock and books",
      "grantsFrom": "select email, role from users where deleted_at is null and active and not platform_admin",
      "roles": [
        { "name": "owner", "label": "Owner" },
        { "name": "manager", "label": "Manager" },
        { "name": "accountant", "label": "Accountant" },
        { "name": "cashier", "label": "Cashier" }
      ],
      "twoRoles": false,
      "bootstrap": { "script": "owner:bootstrap", "email": "OWNER_EMAIL", "password": "OWNER_PASSWORD" },
      "extraEnv": { "BUSINESS_TIMEZONE": "Africa/Addis_Ababa" },
      "owner": "owner",
      "people": [
        ["shop.manager", "Mia", "Manager", "manager"],
        ["shop.accountant", "Abel", "Books", "accountant"],
        ["shop.cashier", "Cleo", "Till", "cashier"]
      ]
    },
    "library": {
      "service": "library",
      "repo": "https://github.com/DawitBK/library-management-system",
      "ref": "next",
      "dir": "apps/library-management-system",
      "port": 16102,
      "db": "library",
      "label": "Library",
      "tile": "Library: catalogue and circulation desk",
      "grantsFrom": "select email, role from users where deleted_at is null and active and not platform_admin",
      "roles": [
        { "name": "admin", "label": "Administrator" },
        { "name": "librarian", "label": "Librarian" }
      ],
      "twoRoles": false,
      "bootstrap": { "script": "admin:bootstrap", "email": "ADMIN_EMAIL", "password": "ADMIN_PASSWORD" },
      "extraEnv": {},
      "owner": "admin",
      "people": [
        ["librarian.lia", "Lia", "Librarian", "librarian"],
        ["librarian.sol", "Sol", "Librarian", "librarian"]
      ]
    },
    "martronics": {
      "service": "martronics",
      "repo": "https://github.com/DawitBK/martronics",
      "ref": "next",
      "dir": "apps/martronics",
      "port": 16103,
      "db": "martronics",
      "label": "Martronics",
      "tile": "Martronics: online shop and admin",
      "grantsFrom": "select email, role from users where deleted_at is null and not platform_admin",
      "roles": [
        { "name": "admin", "label": "Administrator" },
        { "name": "manager", "label": "Manager" },
        { "name": "customer", "label": "Customer" }
      ],
      "twoRoles": false,
      "bootstrap": { "script": "admin:bootstrap", "email": "ADMIN_EMAIL", "password": "ADMIN_PASSWORD" },
      "extraEnv": {},
      "owner": "admin",
      "people": [
        ["shop.manager", "Mara", "Manager", "manager"],
        ["customer.dina", "Dina", "Buyer", "customer"],
        ["customer.eli", "Eli", "Buyer", "customer"]
      ]
    },
    "jobpilot": {
      "service": "jobpilot",
      "repo": "https://github.com/DawitBK/jobpilot",
      "ref": "main",
      "dir": "apps/jobpilot",
      "port": 16104,
      "db": "jobpilot",
      "label": "JobPilot",
      "tile": "JobPilot: job search workspace",
      "grantsFrom": "select email, 'member' from users where status = 'ACTIVE' and not platform_admin",
      "roles": [
        { "name": "member", "label": "Member (own workspace)" }
      ],
      "twoRoles": true,
      "bootstrap": null,
      "extraEnv": {},
      "owner": null,
      "people": [
        ["jobseeker.ana", "Ana", "Candidate"],
        ["jobseeker.ben", "Ben", "Candidate"],
        ["recruiter.rita", "Rita", "Recruiter"]
      ]
    }
  },
  "externalClients": {
    "_note": "Applications that sign in through the identity provider but are not built here (MOS runs from its own repository). Only the roles the console offers for them are listed; they are registered when MOS_ORIGIN is set in .env. MOS never takes the administrator role from the identity provider: it is granted inside MOS, and the role listed here only lets the person in.",
    "mos": {
      "roles": [
        { "name": "admin", "label": "Administrator (access; the role itself is granted inside MOS)" },
        { "name": "guard", "label": "Gate guard" },
        { "name": "verifier", "label": "Weighbridge verifier" },
        { "name": "gatesup", "label": "Gate supervisor" },
        { "name": "analyst", "label": "Lab analyst" },
        { "name": "labmanager", "label": "Lab manager" },
        { "name": "storekeeper", "label": "Storekeeper" },
        { "name": "buyer", "label": "Buyer" },
        { "name": "procurement", "label": "Procurement manager" },
        { "name": "production", "label": "Production supervisor" },
        { "name": "salesrep", "label": "Sales representative" },
        { "name": "salesmanager", "label": "Sales manager" },
        { "name": "cashier", "label": "Cashier" },
        { "name": "apclerk", "label": "Accounts payable clerk" },
        { "name": "deptmanager", "label": "Department manager" },
        { "name": "finance", "label": "Finance manager" },
        { "name": "gm", "label": "General manager" }
      ]
    }
  }
}
